# скопіюй у .env (він у .gitignore) і заповни; ключі в git не потрапляють
KA_ENV=dev
KA_DOCS_ENABLED=true
# у prod обовʼязковий, >= 32 символи: python -c "import secrets; print(secrets.token_urlsafe(48))"
KA_JWT_SECRET=
# KA_CORS_ORIGINS=["http://localhost:3000"]
KA_DATABASE_URL=postgresql+psycopg://ka:ka-dev-only@127.0.0.1:5432/ka
KA_REDIS_URL=redis://127.0.0.1:6379/0
KA_STORAGE_DIR=./data/uploads
KA_MAX_UPLOAD_BYTES=10485760
KA_EMBEDDING_MODEL=
KA_LLM_BASE_URL=
KA_LLM_API_KEY=
KA_LLM_MODEL=
